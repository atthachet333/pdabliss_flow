# PDA BLISS FLOW — environment template (PLACEHOLDERS ONLY — this file is public)
#
# Real values NEVER go in this project folder (it is a public GitHub repo AND synced by
# OneDrive). Put them in the external secret file created by:
#   powershell -NoProfile -ExecutionPolicy Bypass -File .\scripts\ep01-setup-secrets.ps1
# Default location: %USERPROFILE%\.pdabliss\flow\dev.env  (override: FLOW_ENV_FILE)

# ---- API (apps/api) ----
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=6768
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:6767,http://127.0.0.1:6767

# ---- EP01 LINE integration (values belong in the external secret file) ----
# Public identifiers (not credentials, but kept out of tracked config on purpose)
# LINE_LOGIN_CHANNEL_ID=<10-digit LINE Login channel ID>
# LINE_MESSAGING_CHANNEL_ID=<10-digit Messaging API channel ID>
# LINE_LIFF_ID=<LIFF ID, e.g. 1234567890-AbCdEfGh>
# Secrets
# LINE_MESSAGING_CHANNEL_SECRET=<32 hex chars — Messaging API channel › Basic settings>
# LINE_CHANNEL_ACCESS_TOKEN=<long-lived token — Messaging API tab> (optional: read-only status)
# SESSION_SECRET=<48+ random characters — generated by the setup script>
# Access (testers only; the owner is enrolled with `npm run access -- approve …`)
# FLOW_ALLOWED_LINE_USER_IDS=<comma-separated LINE user IDs>
# Public HTTPS origin of the current dev tunnel (set by scripts\ep01-integration.ps1)
# PUBLIC_BASE_URL=https://<random>.trycloudflare.com
# Optional: Sally's bot user ID (otherwise read once from GET /v2/bot/info)
# LINE_BOT_USER_ID=<U + 32 hex>

# ---- Database (planned for EP03; not used yet) ----
# DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5432/pdabliss_flow_dev

# ---- Web (apps/web) ----
WEB_PORT=6767
