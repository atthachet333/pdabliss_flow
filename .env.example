# PDA BLISS FLOW — environment template (PLACEHOLDERS ONLY)
#
# Do NOT put real values in this project folder: it is synchronised by OneDrive.
# From EP01 onwards, load real secrets from outside the synced directory
# (see docs/SECURITY-AND-PRIVACY.md → "Local secret loading").

# ---- API (apps/api) ----
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=6768
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API in development
CORS_ORIGINS=http://localhost:6767,http://127.0.0.1:6767

# ---- Database (not used in EP00; planned for EP03) ----
# Development and test databases MUST be different. Never point these at production.
# DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5432/pdabliss_flow_dev
# DATABASE_URL_TEST=postgresql://<user>:<password>@127.0.0.1:5432/pdabliss_flow_test

# ---- LINE (not used in EP00; planned for EP01) ----
# LINE_CHANNEL_ID=<placeholder>
# LINE_CHANNEL_SECRET=<placeholder>
# LINE_CHANNEL_ACCESS_TOKEN=<placeholder>
# LINE_LOGIN_CHANNEL_ID=<placeholder>
# LIFF_ID=<placeholder>

# ---- Web (apps/web) ----
# Vite dev server port (see apps/web/vite.config.ts)
WEB_PORT=6767
